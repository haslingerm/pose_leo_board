<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.6" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
        <PackageReference Include="MessageBox.Avalonia" Version="12.1.0" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="11.0.100" PrivateAssets="All" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../readme.md" Pack="true" PackagePath="" />
    </ItemGroup>

    <PropertyGroup>
        <Title>HTL Leonding Board for simple UI</Title>
        <Description>A utility library for drawing a grid on a canvas with click handler support to e.g. implement Minesweeper</Description>
        <PackageId>HTLLeonding.Utility.LeoBoard</PackageId>
        <PackageReadmeFile>readme.md</PackageReadmeFile>
        <PackageType>Dependency</PackageType>
        <PackageVersion>4.0.0</PackageVersion>
        <Authors>M. Haslinger</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageTags>skia;HTL-Leonding;board;drawing;avalonia</PackageTags>
        <RepositoryUrl>https://github.com/haslingerm/pose_leo_board</RepositoryUrl>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

</Project>
